  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/vercel-static-build.mjs",
    "start": "node server/online-server.mjs",
    "start:online": "node server/online-server.mjs",
    "vercel:login": "npx --yes vercel@latest login",
